# Server only. NEVER use EXPO_PUBLIC_ for OpenAI/provider client secrets.
OPENAI_API_KEY=
# Choose a Responses API model available to your account that supports structured outputs.
OPENAI_MODEL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required only for Google/Microsoft connections. Keep this on the server.
SUPABASE_SERVICE_ROLE_KEY=

# OAuth tokens are encrypted with AES-256-GCM before database storage.
# Generate 32 random bytes and base64-encode them. Never commit the real value.
INTEGRATION_ENCRYPTION_KEY=
# Long random secret used to sign short-lived OAuth state values.
OAUTH_STATE_SECRET=

# Google Cloud OAuth web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the authorized redirect URI configured in Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth/google/callback

# Microsoft Entra app registration credentials.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Must exactly match the redirect URI configured in Entra.
MICROSOFT_REDIRECT_URI=http://localhost:8787/oauth/microsoft/callback

# Where the backend sends the browser after provider consent.
# For a development/production build the custom scheme is defined in app.json.
APP_RETURN_URL=planner-ai://connections

PORT=8787
# Use 0.0.0.0 only when testing from your phone on a trusted LAN.
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:8081
