{
  "expo": {
    "name": "Planner AI",
    "slug": "planner-ai",
    "version": "0.1.0",
    "scheme": "planner-ai",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hibayoussfi.plannerai"
    },
    "android": {
      "package": "com.hibayoussfi.plannerai"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "baseUrl": "/Planner-AI"
    }
  }
}
